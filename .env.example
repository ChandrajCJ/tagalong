# Copy to .env and adjust. Used by apps/api, apps/worker and packages/db.
NODE_ENV=development
PORT=3000

DATABASE_URL=postgres://tagalong:tagalong@localhost:5432/tagalong
TEST_DATABASE_URL=postgres://tagalong:tagalong@localhost:5432/tagalong_test
REDIS_URL=redis://localhost:6380

# Object storage (SeaweedFS from docker-compose; any S3-compatible service works)
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=tagalong
S3_ACCESS_KEY=tagalong
S3_SECRET_KEY=tagalong-secret

# Any long random string. Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# apps/mobile/.env — your laptop's LAN IP so the phone can reach the API
# EXPO_PUBLIC_API_URL=http://192.168.1.20:3000
