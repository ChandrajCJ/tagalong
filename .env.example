# Copy to .env and adjust. Used by apps/api, apps/worker and packages/db.
NODE_ENV=development
PORT=3000

DATABASE_URL=postgres://tagalong:tagalong@localhost:5432/tagalong
TEST_DATABASE_URL=postgres://tagalong:tagalong@localhost:5432/tagalong_test
# Hosted Postgres with a pooler (Neon): DATABASE_URL is the pooled address,
# this the direct one, for migrations. Unset uses DATABASE_URL.
# DATABASE_DIRECT_URL=
REDIS_URL=redis://localhost:6380

# Object storage (SeaweedFS from docker-compose; any S3-compatible service works)
S3_ENDPOINT=http://localhost:8333
# Testing on a phone? "localhost" there means the phone. Set this to your
# laptop's LAN address so the upload and photo links work on the device:
# S3_PUBLIC_ENDPOINT=http://192.168.1.20:8333
S3_REGION=us-east-1
S3_BUCKET=tagalong
S3_ACCESS_KEY=tagalong
S3_SECRET_KEY=tagalong-secret

# Any long random string. Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# apps/mobile/.env — your laptop's LAN IP so the phone can reach the API
# EXPO_PUBLIC_API_URL=http://192.168.1.20:3000

# Daily exchange rates for expenses in other currencies (free, no key).
# FX_API_URL=https://api.frankfurter.dev/v1

# Travel times between plan stops (OSRM; free, no key, fair use). Point it at
# your own OSRM servers if you run them (same /routed-foot, -car, -bike paths).
# ROUTING_URL=https://routing.openstreetmap.de

# Bookings by email (optional; docs/DEPLOY.md). Leave unset and the app offers
# paste and "read a ticket from Docs" instead of a forwarding address.
# IMPORT_IMAP_URL=imaps://tagalong.inbox%40gmail.com:APP-PASSWORD@imap.gmail.com:993
# IMPORT_ADDRESS=tagalong.inbox@gmail.com

# Sign-in emails through Brevo's HTTPS API instead of SMTP, for hosts that
# block SMTP (Render's free plan). Wins over SMTP_URL. See docs/DEPLOY-FREE.md.
# BREVO_API_KEY=
