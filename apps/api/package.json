{
  "name": "@tagalong/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./jobs": "./src/jobs/index.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "dev:gateway": "tsx watch --env-file-if-exists=../../.env src/gateway.ts",
    "start:gateway": "tsx --env-file-if-exists=../../.env src/gateway.ts",
    "dev:all": "tsx watch --env-file-if-exists=../../.env src/all.ts",
    "build": "node build.mjs",
    "start:all": "node --enable-source-maps dist/all.js",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.2",
    "@fastify/websocket": "^11.3.3",
    "@photostructure/tz-lookup": "11.7.0",
    "@tagalong/db": "workspace:*",
    "@tagalong/shared": "workspace:*",
    "bullmq": "^6.3.8",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "imapflow": "2.1.2",
    "ioredis": "^6.0.0",
    "mailparser": "3.9.31",
    "nodemailer": "^10.1.0",
    "sharp": "^0.35.5",
    "unpdf": "1.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "@types/nodemailer": "^8.0.2",
    "@types/ws": "^8.18.2",
    "esbuild": "~0.25.12",
    "pino-pretty": "^13.1.3",
    "ws": "^8.22.0"
  }
}
