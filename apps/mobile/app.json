{
  "expo": {
    "name": "Tagalong",
    "slug": "tagalong",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tagalong",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.chandrajcj.tagalong"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F6F3EE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.chandrajcj.tagalong",
      "blockedPermissions": [
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.RECORD_AUDIO"
      ],
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "tagalong-u4wh.onrender.com",
              "pathPrefix": "/invite"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E6B5C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#121210"
          }
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-image",
      [
        "expo-media-library",
        {
          "photosPermission": "Tagalong uses your photos so you can add them to the trip album.",
          "savePhotosPermission": "Tagalong saves trip photos to your gallery when you download them.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-video",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Tagalong uses your location only when you choose Share my location, so the people on your trip can see where you are for the time you pick.",
          "locationAlwaysAndWhenInUsePermission": "Tagalong uses your location only when you choose Share my location. Allowing it all the time keeps sharing going while the app is closed, until the time you picked runs out.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-task-manager",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "TripCountdown",
              "label": "Trip countdown",
              "description": "Your next trip and how long until it starts",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "previewImage": "./assets/widget-preview/countdown.png",
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical"
            },
            {
              "name": "TripToday",
              "label": "Trip today",
              "description": "During a trip, today's next stop and booking; before it, the countdown and packing",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "previewImage": "./assets/widget-preview/today.png",
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical"
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0de1aa1d-890f-45cf-a533-2978608d6ed5"
      }
    },
    "owner": "chandraj_n",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/0de1aa1d-890f-45cf-a533-2978608d6ed5",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
