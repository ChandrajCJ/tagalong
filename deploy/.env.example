# Copy to deploy/.env on the server and fill in the first block.
# deploy/init.sh fills in the secrets in the second block for you.

# Your free DuckDNS name, without https:// (e.g. tagalong-priya.duckdns.org).
# The app uses app.<DOMAIN>, api.<DOMAIN> and files.<DOMAIN>.
DOMAIN=
# Let's Encrypt emails you here if a certificate can't renew.
ACME_EMAIL=
# Sends sign-in codes. Gmail: smtps://you%40gmail.com:APP-PASSWORD@smtp.gmail.com:465
# (write @ in the address as %40, and remove the spaces from the app password).
SMTP_URL=
MAIL_FROM=Tagalong <you@gmail.com>

# Filled in by deploy/init.sh. Keep this file private and backed up.
POSTGRES_PASSWORD=
JWT_SECRET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
