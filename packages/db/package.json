{
  "name": "@tagalong/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/migrate.ts",
    "db:migrate:test": "tsx --env-file-if-exists=../../.env src/migrate.ts --test",
    "db:seed": "tsx --env-file-if-exists=../../.env src/seed.ts",
    "db:studio": "drizzle-kit studio",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11"
  },
  "dependencies": {
    "@tagalong/shared": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "postgres": "^3.4.9"
  }
}
