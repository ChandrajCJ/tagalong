{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:gateway": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {},
    "test": {
      "cache": false,
      "passThroughEnv": [
        "NODE_ENV",
        "DATABASE_URL",
        "TEST_DATABASE_URL",
        "REDIS_URL",
        "JWT_SECRET",
        "S3_*"
      ]
    }
  }
}
